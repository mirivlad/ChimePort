# Replace with your real HTTPS origin, with no trailing slash.
CHIMEPORT_PUBLIC_URL=https://notify.example.org
# Optional immutable image for rollback, e.g. ghcr.io/mirivlad/chimeport:sha-<40-hex-commit>
# CHIMEPORT_IMAGE=ghcr.io/mirivlad/chimeport:v0.1.3
# Optional bind mount for restored data; default remains the original named Docker volume
# CHIMEPORT_DATA_MOUNT=/srv/chimeport/restored-YYYYMMDD
